{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://adp.dev/schema/authority.schema.json","title":"Authority","type":"object","additionalProperties":false,
  "required":["capabilities","filesystem","network","subprocess","credentials","sideEffects","delegation"],
  "properties":{
    "capabilities":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "filesystem":{"type":"object","additionalProperties":false,"required":["read","write"],"properties":{"read":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"write":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "network":{"oneOf":[{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"none"}}},{"type":"object","additionalProperties":false,"required":["mode","destinations"],"properties":{"mode":{"const":"bounded"},"destinations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}}},{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"any"}}}]},
    "subprocess":{"type":"object","additionalProperties":false,"required":["allowed"],"properties":{"allowed":{"type":"boolean"},"commands":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "credentials":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["handle"],"properties":{"handle":{"type":"string","pattern":"^[A-Za-z0-9._:-]+$"},"scopes":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},"uniqueItems":true},
    "sideEffects":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "approvals":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["action","required"],"properties":{"action":{"type":"string"},"required":{"type":"boolean"}}}},
    "delegation":{"type":"object","additionalProperties":false,"required":["allowed","maxDepth"],"properties":{"allowed":{"type":"boolean"},"maxDepth":{"type":"integer","minimum":0}}}
  }
}
